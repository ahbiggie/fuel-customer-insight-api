{
  "name": "fuel-customer-insight-api",
  "version": "1.0.0",
  "description": "REST API for tracking customer purchase behaviour, loyalty campaigns, and SMS notifications for fuel retail stations.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate --config src/config/config.cjs --migrations-path migrations",
    "migrate:undo": "sequelize-cli db:migrate:undo --config src/config/config.cjs --migrations-path migrations",
    "seed": "sequelize-cli db:seed:all --config src/config/config.cjs --seeders-path seeders",
    "seed:undo": "sequelize-cli db:seed:undo:all --config src/config/config.cjs --seeders-path seeders",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahbiggie/fuel-customer-insight-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ahbiggie/fuel-customer-insight-api/issues"
  },
  "homepage": "https://github.com/ahbiggie/fuel-customer-insight-api#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
